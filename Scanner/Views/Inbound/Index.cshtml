@model Scanner.Models.AsnListViewModel

@{
    ViewData["Title"] = "Inbound ASN";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>📦 Danh sách Xe vào (ASN)</h4>
    <button class="btn btn-outline-secondary btn-sm" onclick="location.reload()">
        <i class="bi bi-arrow-clockwise"></i> Làm mới
    </button>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" role="alert">
        @Html.ValidationSummary(false, "", new { @class = "mb-0" })
    </div>
}

<div class="row row-cols-1 row-cols-md-2 g-3">
    @if (Model.Items != null && Model.Items.Any())
    {
        foreach (var item in Model.Items)
        {
            <div class="col">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <span class="fw-bold fs-5">@item.VehicleNo</span>
                        <span class="badge bg-light text-dark">@item.Status</span>
                    </div>
                    <div class="card-body">
                        <div class="row mb-2">
                            <div class="col-6">
                                <small class="text-muted d-block">Tài xế</small>
                                <strong>@item.DriverName</strong><br />
                                <a href="tel:@item.DriverPhone" class="text-decoration-none">📞 @item.DriverPhone</a>
                            </div>
                            <div class="col-6 text-end">
                                <small class="text-muted d-block">Tuyến</small>
                                <strong>@item.RouteCode</strong>
                            </div>
                        </div>

                        <hr class="my-2" />

                        <div class="row g-1 mb-3 text-center">
                            <div class="col-4 text-start">
                                <small class="text-muted d-block text-truncate" style="font-size: 0.75rem;">Cửa nhập
                                    (Dock)</small>
                                <span class="badge bg-info text-dark">@item.DockCode</span>
                            </div>
                            <div class="col-4">
                                <small class="text-muted d-block text-truncate" style="font-size: 0.75rem;">SKU dự kiến</small>
                                <span class="fw-bold fs-6">@item.NumOfSku</span>
                            </div>
                            <div class="col-4 text-end">
                                <small class="text-muted d-block text-truncate" style="font-size: 0.75rem;">Thực nhận</small>
                                <span class="fw-bold text-success fs-6">@(item.ActualQty ?? 0)</span>
                            </div>
                        </div>

                        @if (item.Status.Equals("Receipt", StringComparison.OrdinalIgnoreCase) || item.Status.Equals("Reciept", StringComparison.OrdinalIgnoreCase))
                        {
                            <a href="@Url.Action("Putaway", "Inbound", new { asnId = item.AsnId })"
                                class="btn btn-primary w-100 fw-bold py-2">
                                📦 Chọn Pallet
                            </a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-success w-100 fw-bold py-2 btn-arrive" data-id="@item.AsnId"
                                data-vehicle="@item.VehicleNo">
                                ✅ Báo Xe Đã Tới
                            </button>
                        }
                    </div>
                    <div class="card-footer text-muted text-center fs-7 arrived-time" id="time-@item.AsnId"
                        style="display: none;">
                        <!-- Time will be injected here via JS -->
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <span class="fs-1">📭</span>
            <p class="text-muted mt-2">Không có dữ liệu ASN nào.</p>
        </div>
    }
</div>

@{
    var totalPages = Math.Max(1, (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize));
}

<nav class="mt-4" aria-label="Page navigation">
    <ul class="pagination justify-content-center">
        <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex - 1)">Trước</a>
        </li>
        @for (int i = 1; i <= totalPages; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
            </li>
        }
        <li class="page-item @(Model.PageIndex >= totalPages ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex + 1)">Tiếp</a>
        </li>
    </ul>
</nav>

<!-- Modal Báo Xe Đã Tới -->
<div class="modal fade" id="arrivalModal" tabindex="-1" aria-labelledby="arrivalModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="arrivalModalLabel">Xác nhận Xe đã tới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                    aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="arrivalForm">
                    <input type="hidden" id="modalAsnId" />
                    <div class="mb-3">
                        <label for="actualQty" class="form-label fw-bold">Số lượng hàng thực nhận</label>
                        <input type="number" class="form-control form-control-lg" id="actualQty" name="actualQty"
                            placeholder="Nhập số lượng..." step="any" min="0">
                    </div>
                    <div class="mb-3">
                        <label for="actualTemp" class="form-label fw-bold">Nhiệt độ lúc nhận (°C)</label>
                        <input type="text" class="form-control form-control-lg" id="actualTemp" name="actualTemp"
                            placeholder="Nhập nhiệt độ (nếu có)...">
                    </div>
                    <div class="mb-3 text-danger small fw-bold" id="validationError" style="display: none;">
                        ⚠️ Vui lòng nhập đầy đủ Số lượng và Nhiệt độ!
                    </div>
                </form>
                <div class="alert alert-info py-2 small mb-0">
                    <i class="bi bi-info-circle me-1"></i> Xác nhận xe <strong id="modalVehicleNo"></strong> đã tới bãi
                    và ghi nhận thông số.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-success px-4 fw-bold" id="btnConfirmArrival">Xác nhận</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var currentBtn = null;
            var arrivalModal = new bootstrap.Modal(document.getElementById('arrivalModal'));

            $('.btn-arrive').click(function () {
                currentBtn = $(this);
                var id = currentBtn.data('id');
                var vehicle = currentBtn.data('vehicle');

                $('#modalAsnId').val(id);
                $('#modalVehicleNo').text(vehicle);
                $('#actualQty').val('').removeClass('is-invalid');
                $('#actualTemp').val('').removeClass('is-invalid');
                $('#validationError').hide();

                arrivalModal.show();
            });

            $('#btnConfirmArrival').click(function () {
                if (!currentBtn) return;

                var id = $('#modalAsnId').val();
                var actualQty = $('#actualQty').val();
                var actualTemp = $('#actualTemp').val();

                // Validation
                if (!actualQty || !actualTemp) {
                    $('#validationError').slideDown();

                    // Highlight empty fields
                    if (!actualQty) $('#actualQty').addClass('is-invalid');
                    else $('#actualQty').removeClass('is-invalid');

                    if (!actualTemp) $('#actualTemp').addClass('is-invalid');
                    else $('#actualTemp').removeClass('is-invalid');

                    return;
                }

                // Clear validation errors
                $('#validationError').hide();
                $('.is-invalid').removeClass('is-invalid');

                var originalHtml = currentBtn.html();
                currentBtn.html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Đang xử lý...').prop('disabled', true);

                $('#btnConfirmArrival').prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status"></span>');

                $.post('@Url.Action("UpdateStatus", "Inbound")', {
                    id: id,
                    actualQty: actualQty,
                    actualTemp: actualTemp
                })
                    .done(function (response) {
                        arrivalModal.hide();
                        if (response.success) {
                            // Change button appearance
                            currentBtn.removeClass('btn-success').addClass('btn-secondary').html('✔️ Đã cập nhật');

                            // Show time
                            $('#time-' + id).text('Time: ' + response.timestamp).slideDown();
                        } else {
                            alert('Lỗi: ' + response.message);
                            currentBtn.html(originalHtml).prop('disabled', false);
                        }
                    })
                    .fail(function () {
                        arrivalModal.hide();
                        alert('Không kết nối được với máy chủ để cập nhật!');
                        currentBtn.html(originalHtml).prop('disabled', false);
                    })
                    .always(function () {
                        $('#btnConfirmArrival').prop('disabled', false).text('Xác nhận');
                    });
            });
        });
    </script>
}
