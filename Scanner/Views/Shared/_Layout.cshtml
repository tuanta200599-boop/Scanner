@using Microsoft.AspNetCore.Authentication
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    @* <script>
    // Enforce PWA Standalone Mode
    (function () {
    const isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone ===
    true;
    const isInstallPage = window.location.pathname.toLowerCase().includes('/home/install');

    if (!isStandalone && !isInstallPage) {
    window.location.replace('/Home/Install');
    }
    })();
    </script> *@
    <meta name="viewport"
        content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="WMS Scanner">
    <!-- Thêm icon cho iOS (tạm thời dùng favicon, bạn nên thay bằng icon 192x192) -->
    <link rel="apple-touch-icon" href="~/favicon.ico">
    <link rel="manifest" href="~/manifest.json" />
    <title>@ViewData["Title"] - Scanner</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Scanner.styles.css" asp-append-version="true" />
    <script type="module" src="/index.js"></script>
</head>

<body>
    <!-- FB Mobile Tabs Bar (Main Nav) -->
    <div class="fb-tabs-bar">
        <a class="fb-tab-item active" href="/">
            <i class="bi bi-house-door-fill"></i>
        </a>
        <a class="fb-tab-item" href="/Inbound">
            <i class="bi bi-box-seam"></i>
        </a>
        <a class="fb-tab-item" href="/Outbound/Picking">
            <i class="bi bi-cart-fill"></i>
        </a>
        <a class="fb-tab-item" href="" @* href="/Inventory/Inquiry"*@>
            <i class="bi bi-search-heart"></i>
        </a>
        <!-- Notifications Icon -->
        <div class="fb-tab-item" id="notif-toggle">
            <i class="bi bi-bell-fill"></i>
            <span class="badge rounded-pill bg-danger"
                style="position: absolute; top: 10px; right: 20%; font-size: 10px;">3</span>
        </div>
        <!-- Hamburger Menu Icon -->
        <div class="fb-tab-item" id="hamburger-menu">
            <i class="bi bi-list"></i>
        </div>
    </div>

    <!-- Notification Box (Mock Data) -->
    <div class="fb-notif-box" id="notif-box">
        <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-white sticky-top">
            <h5 class="fw-bold m-0">Thông báo</h5>
            <i class="bi bi-check-all text-primary fs-4"></i>
        </div>
        <div class="notif-list">
            <div class="notif-item unread">
                <i class="bi bi-box-seam-fill bg-info text-white me-3"></i>
                <div class="border-bottom pb-2 w-100">
                    <div class="fw-bold">Lô hàng mới #ASN12345</div>
                    <div class="text-muted small">Vừa mới xong • Nhập kho</div>
                </div>
            </div>
            <div class="notif-item unread">
                <i class="bi bi-exclamation-triangle-fill bg-warning text-white me-3"></i>
                <div class="border-bottom pb-2 w-100">
                    <div class="fw-bold">Cảnh báo tồn kho thấp: Pallet #P-099</div>
                    <div class="text-muted small">1 giờ trước • Kiểm kê</div>
                </div>
            </div>
            <div class="notif-item">
                <i class="bi bi-person-check-fill bg-success text-white me-3"></i>
                <div class="border-bottom pb-2 w-100">
                    <div class="fw-bold">Hệ thống đã cập nhật Token FCM</div>
                    <div class="text-muted small">Hôm nay lúc 09:12</div>
                </div>
            </div>
            <div class="notif-item">
                <i class="bi bi-check-circle-fill bg-primary text-white me-3"></i>
                <div class="border-bottom pb-2 w-100">
                    <div class="fw-bold">Picking hoàn thành: Đơn #SOL-7788</div>
                    <div class="text-muted small">Hôm qua lúc 17:45</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Slide-out Menu Overlay -->
    <div class="fb-menu-overlay" id="menu-overlay"></div>
    <div class="fb-side-menu" id="side-menu">
        <div class="px-3 mb-4">
            <h4 class="fw-bold">Menu</h4>
        </div>

        <a class="fb-menu-item" href="/">
            <i class="bi bi-person-fill"></i>
            <span>Trang cá nhân</span>
        </a>
        <a class="fb-menu-item" href="/Home/Privacy">
            <i class="bi bi-shield-lock-fill"></i>
            <span>Quyền riêng tư</span>
        </a>
        <a class="fb-menu-item" href="#">
            <i class="bi bi-gear-fill"></i>
            <span>Cài đặt</span>
        </a>

        <a class="fb-menu-item fb-menu-logout" href="#" onclick="handleLogout(event)">
            <i class="bi bi-box-arrow-right"></i>
            <span>Đăng xuất</span>
        </a>
    </div>

    <div class="container-fluid p-0">
        <main role="main" class="p-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
            // Hàm thêm thông báo vào UI (Sẽ được gọi từ index.js)
            window.addNotificationToUI = function (payload) {
                console.log('--- UI nhận được Notification payload:', payload);
                const title = payload.notification?.title || payload.data?.title || "Thông báo hệ thống";
                const body = payload.notification?.body || payload.data?.body || "Bạn có tin nhắn mới";
                const time = "Vừa xong";

                // Tạo icon ngẫu nhiên hoặc dựa trên data cho sinh động
                const icons = ["bi-info-circle-fill bg-primary", "bi-lightning-fill bg-warning", "bi-bell-fill bg-info"];
                const randomIcon = icons[Math.floor(Math.random() * icons.length)];

                const notifHtml = `
                    <div class="notif-item unread">
                        <i class="bi ${randomIcon} text-white me-3"></i>
                        <div class="border-bottom pb-2 w-100">
                            <div class="fw-bold text-dark">${title}</div>
                            <div class="text-muted small">${time} • Hệ thống</div>
                            <div class="small mt-1 text-secondary">${body}</div>
                        </div>
                    </div>
                `;

                // Thêm vào đầu danh sách
                const $list = $('.notif-list');
                if ($list.length) {
                    $list.prepend(notifHtml);
                    console.log('✅ Đã chèn HTML thông báo vào danh sách');
                } else {
                    console.warn('⚠️ Không tìm thấy class .notif-list để chèn thông báo');
                }

                // Cập nhật Badge
                const $badge = $('#notif-toggle .badge');
                if ($badge.length) {
                    let count = parseInt($badge.text()) || 0;
                    $badge.text(count + 1).show();
                    console.log('✅ Đã cập nhật Badge thông báo:', count + 1);
                }
            };

        $(document).ready(function () {
            // Toggle side menu
            $('#hamburger-menu, #menu-overlay').on('click', function () {
                var menu = $('#side-menu');
                var overlay = $('#menu-overlay');
                $('#notif-box').removeClass('show'); // Hide notif box when menu opens

                if (menu.hasClass('show')) {
                    menu.removeClass('show');
                    overlay.fadeOut(300);
                } else {
                    overlay.show().css('opacity', 1);
                    menu.addClass('show');
                }
            });

            // Toggle notification box
            $('#notif-toggle').on('click', function (e) {
                e.stopPropagation();
                $('#notif-box').toggleClass('show');
                $('#side-menu').removeClass('show'); // Hide menu when notif opens
                if ($('#notif-box').hasClass('show')) {
                    $('#menu-overlay').show().css('opacity', 0); // Transparent overlay to close on click outside
                } else {
                    $('#menu-overlay').fadeOut(300);
                }
            });

            // Click outside to close
            $(document).on('click', function (e) {
                if (!$(e.target).closest('#notif-box, #notif-toggle, #side-menu, #hamburger-menu').length) {
                    $('#notif-box').removeClass('show');
                    $('#side-menu').removeClass('show');
                    $('#menu-overlay').fadeOut(300);
                }
            });

            // Active tab handling
            var currentPath = window.location.pathname;
            $('.fb-tab-item').not('#hamburger-menu, #notif-toggle').removeClass('active');
            $('.fb-tab-item').each(function () {
                var href = $(this).attr('href');
                if (href && currentPath === href) {
                    $(this).addClass('active');
                }
            });
            if (currentPath === '/') $('.fb-tab-item:first').addClass('active');

        });

        // Hàm xử lý Logout để xóa màn hình cũ trước khi chuyển hướng sang tab OIDC của PWA
        function handleLogout(e) {
            if (e) e.preventDefault();
            // Xóa body và hiển thị thông báo đang đăng xuất
            document.body.innerHTML = `
                <div style="display:flex; height:100vh; width:100vw; justify-content:center; align-items:center; flex-direction:column; background-color:#f8f9fa;">
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
                    <h4 class="mt-4 text-secondary">Đang đăng xuất...</h4>
                    <p class="text-muted small mt-2">Vui lòng hoàn tất ở cửa sổ đăng nhập</p>
                </div>
            `;
            // Chuyển hướng tới trang Logout
            window.location.href = '/Account/Logout';
        }
    </script>


    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
